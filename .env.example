# Copy to .env and fill in your own Blizzard API credentials.
# Never commit .env; anything prefixed VITE_ is inlined into the browser bundle.

# Server-side (never VITE_): used by the Vite dev proxy and the Netlify function
BNET_CLIENT_ID=your-client-id
BNET_CLIENT_SECRET=your-client-secret
BNET_REGION=us
# BNET_API_BASE_URL=https://us.api.blizzard.com
# BNET_OAUTH_BASE_URL=https://oauth.battle.net
# Per-IP requests/minute enforced by the Netlify function (default 600, 0 disables).
# The Vite dev proxy leaves it off unless this is set.
# BNET_PROXY_RATE_LIMIT=600

# Browser-side (inlined into the bundle)
VITE_BNET_REGION=us
VITE_BNET_LOCALE=en_US
# Dev-only shortcut; ignored by `vite build`
VITE_BNET_ACCESS_TOKEN=
# Dev-only override; production keeps /api/blizzard unless netlify.toml is changed too
# VITE_BNET_PROXY_PATH=/api/blizzard

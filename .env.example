# Copy to .env and fill in your own Blizzard API credentials.
# Never commit .env; anything prefixed VITE_ is inlined into the browser bundle.
# On Netlify, set these under Project configuration > Environment variables, not in
# netlify.toml (variables declared there never reach functions).

# Server-side (never VITE_): used by the Vite dev proxy and the Netlify function
BNET_CLIENT_ID=your-client-id
BNET_CLIENT_SECRET=your-client-secret
BNET_REGION=us
# Pins every request to one host and disables per-region routing; normally unset.
# BNET_API_BASE_URL=https://us.api.blizzard.com
# BNET_OAUTH_BASE_URL=https://oauth.battle.net
# Per-IP requests/minute for the function's own per-instance limiter (default 600,
# 0 disables it). The Vite dev proxy leaves it off unless this is set. On Netlify
# the edge limit in config.rateLimit (600/min per IP) applies regardless; edit
# windowLimit in netlify/functions/blizzard-proxy.ts to change that one.
# BNET_PROXY_RATE_LIMIT=600

# Browser-side (inlined into the bundle)
VITE_BNET_REGION=us
VITE_BNET_LOCALE=en_US
# Dev-only shortcut for `vite dev`; production builds ignore it. Never set it on Netlify.
# VITE_BNET_ACCESS_TOKEN=
# Proxy prefix. Also inlined into production builds, so leave it unset on Netlify:
# the function's config.path and the prefix it strips assume /api/blizzard.
# VITE_BNET_PROXY_PATH=/api/blizzard

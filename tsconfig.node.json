{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "server/**/*.ts",
    "netlify/functions/**/*.ts",
    "src/lib/region.ts"
  ]
}
